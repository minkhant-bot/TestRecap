GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPT_TIMEOUT_MS=120000
MAX_UPLOAD_SIZE_MB=500

# CPU-bound pipeline stage tuning. All are optional; unset values fall back
# to the previous hardcoded defaults, so leaving these blank reproduces
# existing behavior exactly. Only one job is processed at a time (see
# workspaceWorker/queue concurrency), so raising these lets a single job use
# more of the host's available cores -- it does not enable concurrent jobs.
# Faster-Whisper transcription threads actually used (further capped by
# WHISPER_CPU_THREADS_MAX and real detected CPU count). Default: 4.
WHISPER_CPU_THREADS=
# Ceiling that WHISPER_CPU_THREADS cannot exceed, regardless of host CPU
# count. Default: 4 (the previous hardcoded ceiling). Absolute max: 64.
WHISPER_CPU_THREADS_MAX=
# OpenMP thread count used inside Faster-Whisper. Default: same as the
# resolved WHISPER_CPU_THREADS value.
OMP_NUM_THREADS=
# libx264 encoder thread count for scene-segment rendering and the final
# speed-adjustment pass. Default: 2 (the previous hardcoded value). Max: 32.
FFMPEG_VIDEO_THREADS=
# Concurrent Edge-TTS synthesis requests per job. This is network-bound
# (an external TTS API), not CPU-bound. Default: 3. Max: 20.
TTS_CONCURRENCY=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Local development may use an ignored service-account file. Hosted environments
# should prefer FIREBASE_SERVICE_ACCOUNT_JSON or workload identity.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Comma-separated Firebase UIDs that bootstrap the initial super-admin authority.
# Keep this server-side; configured UIDs cannot be demoted or disabled through the API.
FIREBASE_SUPER_ADMIN_UIDS=
# Optional local Vite overrides. Production reads the safe web config at runtime.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Admission control defaults are suitable for local development. Production must
# set all four limits explicitly. State defaults to DATA_DIR/admission-state.json.
PROCESSING_USAGE_LIMIT=6
PROCESSING_USAGE_WINDOW_MS=86400000
MUTATION_RATE_LIMIT=30
MUTATION_RATE_WINDOW_MS=300000
# ADMISSION_STORE_PATH=

# P2.1 PostgreSQL foundation. Optional until an approved authority cutover.
DATABASE_URL=
DATABASE_REQUIRED=false
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=15000

# Explicitly enables only the PostgreSQL-backed plans/credits/purchase foundation.
# It does not activate live job reservation or settlement.
P2_BILLING_ENABLED=false
P2_LIVE_JOB_BILLING_ENABLED=false

# Private payment proofs are stored below DATA_DIR/payment-proofs.
# Optional integer limit from 1 through 25 MB; default is 10.
PAYMENT_PROOF_MAX_SIZE_MB=10
